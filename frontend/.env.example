# Backend API
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this frontend deployment — used for sitemap.xml, robots.txt,
# and Open Graph/Twitter Card absolute URLs. Like other NEXT_PUBLIC_* vars,
# changing it requires a full redeploy, not just a save.
NEXT_PUBLIC_SITE_URL=https://your-domain-here.com

# Firebase — used for Authentication (email/password + Google) and Cloud
# Messaging (push notifications). Project: burundi-29563.
# Get these from Firebase Console -> Project Settings -> General ->
# your web app's config. These are all safe to expose publicly (Firebase's
# client config isn't a secret) — the private/server-side credentials live
# only in the backend's FIREBASE_* env vars, never here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
