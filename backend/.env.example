# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/burundi-today?appName=Cluster0

# Firebase Admin SDK (project: burundi-29563) — verifies ID tokens issued
# by the frontend's Firebase Auth, and is used by
# scripts/migrate-users-to-firebase.ts to import existing accounts.
# Get these from Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key. Paste the private_key value as-is; the \n
# sequences in it are expected and get converted to real newlines at
# startup (see src/config/firebase.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary — signed direct uploads (see backend/src/config/cloudinary.ts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:3000

# This backend's own public URL — used to build the unsubscribe link in
# outgoing emails (GET /api/newsletter/unsubscribe)
BACKEND_ORIGIN=http://localhost:4000

# Resend — transactional email (newsletter welcome email, etc.)
# Get a key at https://resend.com.
#
# TEST MODE (current setup): sending from onboarding@resend.dev requires
# no domain verification, but Resend will only actually deliver to the
# email address you signed up to Resend with. Fine for development.
#
# PRODUCTION: once you own a real domain (not a *.vercel.app subdomain —
# you can't add DNS records to a domain you don't own), add + verify it
# in Resend, then change MAIL_FROM to an address on that domain, e.g.
# MAIL_FROM=Burundi Today <newsletter@yourdomain.com>
RESEND_API_KEY=
MAIL_FROM=Burundi Today <onboarding@resend.dev>

# Server port (Render sets this automatically in production)
PORT=4000
